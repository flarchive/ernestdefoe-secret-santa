{
    "name": "ernestdefoe/secret-santa",
    "description": "Secret Santa: gift exchanges for your community. Sign-ups with wishlists, an automatic single-cycle draw with exclusions, private shipping notes only your Santa sees, anonymous Santa messages, shipped and received tracking, and a show-what-you-got thread.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "secret santa",
        "gift exchange",
        "christmas",
        "holiday",
        "community"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "homepage": "https://github.com/ernestdefoe/secret-santa",
    "support": {
        "issues": "https://github.com/ernestdefoe/secret-santa/issues",
        "source": "https://github.com/ernestdefoe/secret-santa"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://buymeacoffee.com/ernestdefoe"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\SecretSanta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ErnestDefoe\\SecretSanta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Secret Santa",
            "category": "feature",
            "icon": {
                "name": "fas fa-gift",
                "backgroundColor": "#b91c1c",
                "color": "#fff"
            },
            "optional-dependencies": [
                "flarum/gdpr",
                "flarum/tags"
            ]
        }
    },
    "require-dev": {
        "flarum/gdpr": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/tags": "^2.0",
        "flarum/testing": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
